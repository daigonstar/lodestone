pkgbase = lodestone-bin
	pkgdesc = One library for every game on Linux: Steam, Epic, GOG, Battle.net, EA, Ubisoft, Lutris, Heroic and Minecraft (prebuilt)
	pkgver = 0.1.0
	pkgrel = 1
	url = https://github.com/daigonstar/lodestone
	arch = x86_64
	license = GPL-3.0-or-later
	depends = webkit2gtk-4.1
	depends = gtk3
	depends = glib2
	depends = cairo
	depends = pango
	depends = gdk-pixbuf2
	depends = libsoup3
	depends = hicolor-icon-theme
	depends = xdg-utils
	optdepends = steam: Steam games
	optdepends = lutris: games installed with Lutris
	optdepends = heroic-games-launcher-bin: games installed with Heroic
	optdepends = umu-launcher: use the system umu-run (Lodestone otherwise sets up its own)
	optdepends = mangohud: performance overlay (Lodestone can also set it up itself)
	optdepends = vulkan-tools: MangoHud preview window (vkcube)
	optdepends = gamemode: GameMode status in the MangoHud overlay
	provides = lodestone
	conflicts = lodestone
	options = !strip
	options = !debug
	source = lodestone-0.1.0-x86_64.tar.gz::https://github.com/daigonstar/lodestone/releases/download/0.1.0/lodestone-0.1.0-x86_64.tar.gz
	source = lodestone.desktop
